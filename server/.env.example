# Firebase Admin (Server)
# Download from Firebase Console → Project Settings → Service Accounts
# Then base64 encode: base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_KEY=

# Authentication
# Admin user email (auto-created on first startup)
ADMIN_EMAIL=ottonsilva@gmail.com

# Admin user password (auto-created on first startup)
# Default: usuario123 (when password reset happens)
ADMIN_PASSWORD=Dell@7567

# JWT Secret for authentication
JWT_SECRET=axis-mobili-secret-key

# App Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# CORS
FRONTEND_URL=https://seu-dominio.com

# Optional: Logging
LOG_LEVEL=info
